[Unit]
Description=Create a private Jobhunter SQLite backup

[Service]
Type=oneshot
UMask=0077
WorkingDirectory=%h/projects/job-hunter
Environment=JOBHUNTER_CONFIG=%h/.config/jobhunter/config.yaml
EnvironmentFile=-%h/.config/jobhunter/jobhunter.env
ExecStart=%h/.local/bin/poetry run jobhunter database backup --keep 7
StandardOutput=journal
StandardError=journal
