{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute",
      "options": { "apiKey": "{env:OMNIROUTE_API_KEY}" },
      "models": {
        "auto/coding": { "name": "OmniRoute Auto Coding" },
        "auto/reasoning": { "name": "OmniRoute Auto Reasoning" }
      }
    }
  },
  "model": "omniroute/auto/coding",
  "agent": {
    "build": { "model": "omniroute/auto/coding" },
    "plan": { "model": "omniroute/auto/reasoning" },
    "pipeline": {
      "model": "omniroute/auto/coding",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "allow",
        "bash": {
          "*": "allow",
          "git commit*": "deny",
          "git push*": "deny",
          "gh *": "deny",
          "git tag*": "deny"
        },
        "skill": "allow",
        "todowrite": "allow",
        "question": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "external_directory": "deny",
        "plan_enter": "deny",
        "plan_exit": "deny"
      }
    }
  }
}
